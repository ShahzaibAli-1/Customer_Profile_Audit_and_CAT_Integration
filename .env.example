# Copy this file to .env and fill in your own values. Never commit .env.

# Audit tool (sp4rk case export API)
AUDIT_API_KEY=

# OpenAI - used to build customer profiles
OPENAI_API_KEY=

# CAT tool web app sign-in - used to download case documents
CAT_URL=http://192.168.80.52:2330
CAT_USERNAME=
CAT_PASSWORD=

# Optional overrides
# CAT_API_URL=http://192.168.80.52:2530
# Pacing, so CAT is never asked back-to-back:
# CAT_REQUEST_GAP_S=1.5     at least this many seconds between any two requests to CAT
# CAT_CASE_GAP_S=3-5        a random 3-5 second pause before each CAT case / documents step
# CAT_SEARCH_ATTEMPTS=3     a case CAT does not find is searched again (number + name), with longer pauses
# CASE_EXPORT_URL=http://192.168.80.52:2510/api/case-export/
